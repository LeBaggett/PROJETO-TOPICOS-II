// Envia um byte de comando ou dado para o LCD via SPI
void LCD_Write(uint8_t data, uint8_t mode) {
    HAL_GPIO_WritePin(LCD_DC_GPIO_Port, LCD_DC_Pin, mode); // 0 = Comando, 1 = Dado
    HAL_GPIO_WritePin(LCD_CE_GPIO_Port, LCD_CE_Pin, GPIO_PIN_RESET); // Ativa comunicação
    HAL_SPI_Transmit(&hspi1, &data, 1, HAL_MAX_DELAY); // Transmissão via hardware
    HAL_GPIO_WritePin(LCD_CE_GPIO_Port, LCD_CE_Pin, GPIO_PIN_SET); // Finaliza comunicação
}

// Inicializa o display Nokia 5110
void LCD_Init(void) {
    // Reset de Hardware para iniciar o chip limpo
    HAL_GPIO_WritePin(LCD_RST_GPIO_Port, LCD_RST_Pin, GPIO_PIN_RESET);
    HAL_Delay(10);
    HAL_GPIO_WritePin(LCD_RST_GPIO_Port, LCD_RST_Pin, GPIO_PIN_SET);

    // Comandos de configuração do controlador PCD8544
    LCD_Write(0x21, 0); // Ativa o set de instruções estendidas
    LCD_Write(0xB1, 0); // Ajusta o contraste (VOP) - Valor padrão 0xB1
    LCD_Write(0x04, 0); // Ajusta coeficiente de temperatura
    LCD_Write(0x14, 0); // Ajusta o Bias do display (1:48)
    LCD_Write(0x20, 0); // Retorna para o set de instruções básico
    LCD_Write(0x0C, 0); // Modo de display normal (não invertido)
}

// Limpa toda a tela do LCD
void LCD_Clear(void) {
    for (int i = 0; i < 504; i++) { // 84 colunas * 6 bancos (48 pixels)
        LCD_Write(0x00, 1);
    }
}

// Posiciona o cursor para escrita
void LCD_SetCursor(uint8_t x, uint8_t y) {
    if (x > 83) x = 83; // Limite horizontal
    if (y > 5) y = 5;   // Limite vertical (bancos de 8 bits)

    LCD_Write(0x80 | x, 0); // Define endereço da coluna
    LCD_Write(0x40 | y, 0); // Define endereço da linha (banco)
}

// Escreve um caractere individual da tabela ASCII
void LCD_WriteChar(char c) {
    if (c < 32 || c > 126) return; // Fora da nossa tabela

    for (int i = 0; i < 5; i++) {
        LCD_Write(ASCII[c - 32][i], 1); // Envia as 5 colunas do caractere
    }
    LCD_Write(0x00, 1); // Espaço de 1 pixel entre letras
}

// Escreve uma string completa na tela
void LCD_PrintString(char *str) {
    while (*str) {
        LCD_WriteChar(*str++);
    }
}
